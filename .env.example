# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=terraledger
MYSQL_USER=terraledger
MYSQL_PASSWORD=changeme

# ── IPFS ──────────────────────────────────────────────────────────────────────
IPFS_API_URL=http://ipfs:5001

# ── Document Encryption (AES-256-GCM) ──────────────────────────────────────────
# 256-bit (32-byte) AES key encoded in Hex or Base64
DOCUMENT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Hardhat / EVM ─────────────────────────────────────────────────────────────
HARDHAT_RPC_URL=http://hardhat:8545
# Service wallet private key (officer-authorised; keep in vault in production)
BACKEND_WALLET_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-hex-string
JWT_EXPIRY_SECONDS=3600

# ── OCR service ───────────────────────────────────────────────────────────────
OCR_SERVICE_URL=http://ocr-service:8000

# ── Spring Boot ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
